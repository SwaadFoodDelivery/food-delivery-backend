APP_NAME=service
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=food_delivery
POSTGRES_SSLMODE=disable
REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:9092
JWT_SECRET=replace-me
OTP_PROVIDER=mock
EMAIL_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
S3_PROVIDER=dev
S3_BUCKET=food-delivery-local
S3_BUCKETS=default:food-delivery-local,onboarding:food-delivery-onboarding
S3_DEFAULT_BUCKET=food-delivery-local
S3_ONBOARDING_BUCKET=food-delivery-onboarding
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PRESIGN_TTL_SECONDS=300
S3_MOCK_BASE_URL=http://localhost:9000
ORDER_GRPC_ADDR=localhost:50051
ORDER_GRPC_REQUIRED=false
