# DO NOT COMMIT
APP_NAME=food-delivery-backend
APP_ENV=dev
APP_PORT=8080
LOG_LEVEL=debug

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=food_delivery
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME_MIN=15

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_READ_TIMEOUT_MS=5000

# NATS
NATS_URL=nats://localhost:4222
NATS_CLIENT_ID=food-delivery-backend

# Auth
JWT_SECRET=dev-secret-change-me-please-64-characters-minimum-1234567890
GUEST_TOKEN_SECRET=dev-guest-secret-change-me-in-prod-1234567890abcdef
GUEST_TOKEN_TTL_MIN=60
CLIENT_API_KEY=dev-client-api-key
OTP_PROVIDER=mock
EMAIL_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
SENDGRID_API_KEY=
SENDGRID_ENDPOINT=https://api.sendgrid.com/v3/mail/send
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Food Delivery
ORDER_GRPC_ADDR=localhost:50051
ORDER_GRPC_REQUIRED=false
